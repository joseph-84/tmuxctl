# Installed by deploy/install.sh as ~/.config/systemd/user/tmuxctl.service
# for the account that should own the tmuxctl process (a normal, non-root
# user — see deploy/sudoers.d-tmuxctl for the one privileged operation it's
# allowed to escalate).
#
# Enable + start:
#   systemctl --user enable --now tmuxctl.service
# Keep it running after you log out / over SSH disconnects:
#   loginctl enable-linger "$USER"

[Unit]
Description=tmuxctl — web console for tmux
After=network.target

[Service]
WorkingDirectory=__TMUXCTL_ROOT__
ExecStart=/usr/bin/env node server/index.js
Restart=on-failure
RestartSec=2
Environment=NODE_ENV=production
Environment=PORT=4390
# The whole point of tmux is that sessions outlive whatever attached to
# them — including this service. tmux properly daemonizes (double-fork +
# setsid) but stays in this unit's cgroup, and systemd's default
# KillMode=control-group signals every process in that cgroup on
# stop/restart, killing the tmux server (and every session in it) right
# along with the app. KillMode=process limits the kill to the tracked
# main PID (node) only.
KillMode=process

[Install]
WantedBy=default.target
