# Installed by deploy/install.sh as /etc/pam.d/tmuxctl (Linux).
# Standard local-account stack — authenticates against the same
# /etc/passwd + /etc/shadow accounts a normal SSH/console login uses,
# so there is no separate tmuxctl account database.
#
# macOS note: PAM service files live in /etc/pam.d/ too, but Apple's stack
# uses pam_opendirectory.so instead of pam_unix.so. Replace the two "auth"/
# "account" lines below with:
#   auth    required pam_opendirectory.so
#   account required pam_opendirectory.so
# and skip the Linux-only pam_unix.so lines.

auth    required pam_unix.so
account required pam_unix.so
password required pam_unix.so
session required pam_unix.so
