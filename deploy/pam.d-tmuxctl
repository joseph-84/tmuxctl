# Installed by deploy/install.sh as /etc/pam.d/tmuxctl (Linux only).
# Standard local-account stack — authenticates against the same
# /etc/passwd + /etc/shadow accounts a normal SSH/console login uses,
# so there is no separate tmuxctl account database.
#
# macOS note: this file is NOT installed there. SIP blocks creating new
# files under /etc/pam.d/ even as root (Apple locked this down after
# malware abused custom PAM modules to capture passwords), so there is no
# /etc/pam.d/tmuxctl on macOS. server/config.js instead defaults
# PAM_SERVICE to macOS's built-in "login" service, which already
# authenticates via pam_opendirectory.so — see server/config.js.

auth    required pam_unix.so
account required pam_unix.so
password required pam_unix.so
session required pam_unix.so
